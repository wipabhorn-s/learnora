API_URL=http://localhost:8000
AUTH_SECRET=
# URL จริงของเว็บ (เช่น https://learnora.example.com) — production ต้องตั้ง
# ไม่ตั้ง NextAuth จะปฏิเสธ session ทุกอัน (UntrustedHost) แล้วล็อกอินไม่ได้เลย
# ตอน dev (pnpm dev) ไม่ต้องตั้ง
# AUTH_URL=https://learnora.example.com

# ต้องเป็น client id ตัวเดียวกับที่ API ใช้
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ตัวเดียวกับ GOOGLE_CLIENT_ID แต่ต้องมีคำนำหน้า NEXT_PUBLIC_ เพราะปุ่ม
# เชื่อมบัญชีในหน้า Login & security ทำงานบน browser ผ่าน Google Identity Services
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# public key ของ Opn (pkey_test_...) ให้ Omise.js แปลงบัตรเป็นโทเค็นบน browser
NEXT_PUBLIC_OMISE_PUBLIC_KEY=

# รหัสลับร่วมกับ API (ค่าเดียวกับ INTERNAL_API_SECRET ของ API) — production ต้องตั้ง ตอน dev ไม่ต้อง
INTERNAL_API_SECRET=
