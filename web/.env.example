API_URL=http://localhost:8000
AUTH_SECRET=
# NextAuth v5 เดา URL เองจาก request ตอนรันในเครื่องจึงไม่ต้องใส่
# ตอน deploy ค่อยใส่โดเมนจริง (v4 ใช้ชื่อ NEXTAUTH_URL ซึ่งเลิกใช้แล้ว)
# AUTH_URL=https://your-domain.com

# ต้องเป็น client id ตัวเดียวกับที่ API ใช้
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ตัวเดียวกับ GOOGLE_CLIENT_ID แต่ต้องมีคำนำหน้า NEXT_PUBLIC_ เพราะปุ่ม
# เชื่อมบัญชีในหน้า Login & security ทำงานบน browser ผ่าน Google Identity Services
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
