PORT=8000
# ฐานของลิงก์ที่ส่งไปในอีเมล ต้องไม่มี / ปิดท้าย
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/learnora

# อย่างน้อย 32 ตัวอักษร (ใช้ HMAC รหัส 2FA ด้วย)
ACCESS_TOKEN_SECRET=
# อายุ access token (วินาที) สั้นไว้ เว็บต่ออายุให้เองด้วย refresh token — 900 = 15 นาที
ACCESS_TOKEN_EXPIRES_IN=900
# อายุ refresh token (วินาที) = ไม่ได้เข้าใช้นานเท่านี้ต้องล็อกอินใหม่ — 2592000 = 30 วัน
REFRESH_TOKEN_EXPIRES_IN=2592000

# อายุลิงก์ยืนยันอีเมล (วินาที) — 86400 = 1 วัน
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=86400

# --- Mail (Brevo) ---
# ส่งผ่าน HTTP API ของ Brevo ไม่ใช่ SMTP เพราะโฮสต์ส่วนใหญ่ปิด outbound SMTP
# ขอ key ฟรีได้ที่ https://app.brevo.com -> SMTP & API -> API Keys
# อีเมลผู้ส่งต้อง verify ใน Brevo ก่อน ไม่งั้นจะโดนตอบกลับ 400
MAIL_FROM=
MAIL_FROM_NAME="Learnora"
BREVO_API_KEY=

# อายุลิงก์ตั้งรหัสผ่านใหม่ (วินาที)
RESET_TOKEN_EXPIRES_IN=600

# ต้องเป็น client id ตัวเดียวกับที่เว็บใช้ ไม่งั้น verifyIdToken จะไม่ผ่าน
GOOGLE_CLIENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (Opn Payments / Omise) ---
# Dashboard -> Keys: ใช้ skey_test_... ตอนพัฒนา
OMISE_SECRET_KEY=
# Dashboard -> Webhooks (ค่า base64) ไม่ใส่ก็ได้ตอน dev แต่จะไม่ตรวจลายเซ็น webhook
# URL webhook: https://<host>/payments/opn/webhook
# production: ตั้ง webhook ในโหมด live แยกจากโหมด test และใช้ skey_... ของ live
OMISE_WEBHOOK_SECRET=

# --- Instructor payouts ---
# ส่วนแบ่งของผู้สอนจากราคาคอร์ส (%) ที่เหลือเป็นของแพลตฟอร์ม ไม่ใส่ = 70
INSTRUCTOR_REVENUE_SHARE_PERCENT=70
# กุญแจเข้ารหัสเลขบัญชีธนาคารผู้สอน (32 ไบต์ base64) — แต่ละ environment ใช้คนละกุญแจ
# สร้าง: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ห้ามเปลี่ยนหรือทำหายหลังมีข้อมูลแล้ว ไม่งั้นอ่านเลขบัญชีเดิมไม่ออก
PAYOUT_ENCRYPTION_KEY=

# --- Security ---
# ใครส่ง X-Forwarded-For มาแล้วเชื่อได้ (ใช้หา IP จริงของผู้ใช้สำหรับ rate limit)
# dev: loopback (เว็บกับ API เครื่องเดียวกัน) / production: IP หรือ subnet ของ server เว็บ
TRUST_PROXY=loopback
# รหัสลับร่วมกับเว็บ (ค่าเดียวกันทั้งสองฝั่ง อย่างน้อย 32 ตัว) — production ต้องตั้ง
# API จะเชื่อ IP ของผู้ใช้ที่เว็บส่งมา (X-Client-IP) ตอน dev ไม่ต้องตั้ง
INTERNAL_API_SECRET=
